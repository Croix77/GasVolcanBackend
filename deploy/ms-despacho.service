[Unit]
Description=Gas El Volcan ms-despacho
After=network.target ms-auth.service ms-pedidos.service

[Service]
User=gasvolcan
Environment=SERVER_ADDRESS=127.0.0.1
Environment=SERVER_FORWARD_HEADERS_STRATEGY=framework
Environment=PORT=8085
EnvironmentFile=/etc/gasvolcan/ms-despacho.env
ExecStart=/usr/bin/java -jar /opt/ms-despacho/app.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
