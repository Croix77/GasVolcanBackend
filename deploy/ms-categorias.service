[Unit]
Description=Gas El Volcan ms-categorias
After=network.target

[Service]
User=gasvolcan
Environment=SERVER_ADDRESS=127.0.0.1
Environment=SERVER_FORWARD_HEADERS_STRATEGY=framework
Environment=PORT=8082
EnvironmentFile=/etc/gasvolcan/ms-categorias.env
ExecStart=/usr/bin/java -jar /opt/ms-categorias/app.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
