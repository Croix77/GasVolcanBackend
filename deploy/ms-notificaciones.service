[Unit]
Description=Gas El Volcan ms-notificaciones
After=network.target

[Service]
User=gasvolcan
Environment=SERVER_ADDRESS=127.0.0.1
Environment=SERVER_FORWARD_HEADERS_STRATEGY=framework
Environment=PORT=8087
EnvironmentFile=/etc/gasvolcan/ms-notificaciones.env
ExecStart=/usr/bin/java -jar /opt/ms-notificaciones/app.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
